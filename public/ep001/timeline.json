{"id": "ep001", "title": "Phiên tòa Âm Phủ #1: Tội thức khuya", "fps": 30, "speakers": {"dv": {"name": "DIÊM VƯƠNG", "voice": "vi-VN-NamMinhNeural", "pitch": "-12Hz", "rate": "-4%", "espeak": ["-p", "20", "-s", "150"]}, "meo": {"name": "MÈO SỔ", "voice": "vi-VN-HoaiMyNeural", "pitch": "+0Hz", "rate": "+8%", "espeak": ["-p", "70", "-s", "175"]}, "hon": {"name": "BỊ CÁO", "voice": "vi-VN-NamMinhNeural", "pitch": "+10Hz", "rate": "+10%", "espeak": ["-p", "55", "-s", "180"]}}, "duration": 60.466, "lines": [{"speaker": "dv", "scene": "court", "dv": "shout", "hon": "scared", "overlay": "TỘI DANH: THỨC KHUYA", "text": "Bị cáo! Ngươi có biết mình chết vì tội gì không?", "start": 0.0, "end": 4.114, "words": [{"w": "Bị", "start": 0.0, "end": 0.23}, {"w": "cáo!", "start": 0.23, "end": 0.615}, {"w": "Ngươi", "start": 0.615, "end": 1.075}, {"w": "có", "start": 1.075, "end": 1.306}, {"w": "biết", "start": 1.306, "end": 1.69}, {"w": "mình", "start": 1.69, "end": 2.074}, {"w": "chết", "start": 2.074, "end": 2.458}, {"w": "vì", "start": 2.458, "end": 2.689}, {"w": "tội", "start": 2.689, "end": 2.996}, {"w": "gì", "start": 2.996, "end": 3.226}, {"w": "không?", "start": 3.226, "end": 3.764}]}, {"speaker": "hon", "scene": "court", "dv": "angry", "hon": "scared", "text": "Dạ... con chỉ xem thêm một video nữa thôi mà.", "start": 4.114, "end": 7.366, "words": [{"w": "Dạ...", "start": 4.114, "end": 4.493}, {"w": "con", "start": 4.493, "end": 4.745}, {"w": "chỉ", "start": 4.745, "end": 4.997}, {"w": "xem", "start": 4.997, "end": 5.25}, {"w": "thêm", "start": 5.25, "end": 5.565}, {"w": "một", "start": 5.565, "end": 5.817}, {"w": "video", "start": 5.817, "end": 6.196}, {"w": "nữa", "start": 6.196, "end": 6.448}, {"w": "thôi", "start": 6.448, "end": 6.764}, {"w": "mà.", "start": 6.764, "end": 7.016}]}, {"speaker": "meo", "scene": "court", "dv": "angry", "hon": "scared", "text": "Hồ sơ ghi: ba năm liền, đêm nào cũng hai giờ sáng mới ngủ. Bảy giờ sáng lại đi làm.", "start": 7.366, "end": 13.317, "words": [{"w": "Hồ", "start": 7.366, "end": 7.566}, {"w": "sơ", "start": 7.566, "end": 7.766}, {"w": "ghi:", "start": 7.766, "end": 8.099}, {"w": "ba", "start": 8.099, "end": 8.299}, {"w": "năm", "start": 8.299, "end": 8.566}, {"w": "liền,", "start": 8.566, "end": 8.966}, {"w": "đêm", "start": 8.966, "end": 9.233}, {"w": "nào", "start": 9.233, "end": 9.499}, {"w": "cũng", "start": 9.499, "end": 9.833}, {"w": "hai", "start": 9.833, "end": 10.1}, {"w": "giờ", "start": 10.1, "end": 10.366}, {"w": "sáng", "start": 10.366, "end": 10.7}, {"w": "mới", "start": 10.7, "end": 10.966}, {"w": "ngủ.", "start": 10.966, "end": 11.3}, {"w": "Bảy", "start": 11.3, "end": 11.566}, {"w": "giờ", "start": 11.566, "end": 11.833}, {"w": "sáng", "start": 11.833, "end": 12.166}, {"w": "lại", "start": 12.166, "end": 12.433}, {"w": "đi", "start": 12.433, "end": 12.633}, {"w": "làm.", "start": 12.633, "end": 12.966}]}, {"speaker": "meo", "scene": "flash_bed", "text": "Mắt díp lại rồi mà tay vẫn lướt điện thoại.", "start": 13.317, "end": 16.007, "words": [{"w": "Mắt", "start": 13.317, "end": 13.529}, {"w": "díp", "start": 13.529, "end": 13.742}, {"w": "lại", "start": 13.742, "end": 13.955}, {"w": "rồi", "start": 13.955, "end": 14.168}, {"w": "mà", "start": 14.168, "end": 14.327}, {"w": "tay", "start": 14.327, "end": 14.54}, {"w": "vẫn", "start": 14.54, "end": 14.753}, {"w": "lướt", "start": 14.753, "end": 15.019}, {"w": "điện", "start": 15.019, "end": 15.284}, {"w": "thoại.", "start": 15.284, "end": 15.657}]}, {"speaker": "dv", "scene": "court", "dv": "angry", "hon": "scared", "text": "Nói! Ngươi thức khuya để làm gì?", "start": 16.007, "end": 19.147, "words": [{"w": "Nói!", "start": 16.007, "end": 16.43}, {"w": "Ngươi", "start": 16.43, "end": 16.937}, {"w": "thức", "start": 16.937, "end": 17.36}, {"w": "khuya", "start": 17.36, "end": 17.867}, {"w": "để", "start": 17.867, "end": 18.121}, {"w": "làm", "start": 18.121, "end": 18.459}, {"w": "gì?", "start": 18.459, "end": 18.797}]}, {"speaker": "hon", "scene": "flash_office", "text": "Dạ, cả ngày của con là của sếp, của khách, của deadline. Chỉ có nửa đêm là của riêng con.", "start": 19.147, "end": 25.079, "words": [{"w": "Dạ,", "start": 19.147, "end": 19.395}, {"w": "cả", "start": 19.395, "end": 19.581}, {"w": "ngày", "start": 19.581, "end": 19.892}, {"w": "của", "start": 19.892, "end": 20.14}, {"w": "con", "start": 20.14, "end": 20.388}, {"w": "là", "start": 20.388, "end": 20.574}, {"w": "của", "start": 20.574, "end": 20.822}, {"w": "sếp,", "start": 20.822, "end": 21.132}, {"w": "của", "start": 21.132, "end": 21.38}, {"w": "khách,", "start": 21.38, "end": 21.814}, {"w": "của", "start": 21.814, "end": 22.062}, {"w": "deadline.", "start": 22.062, "end": 22.682}, {"w": "Chỉ", "start": 22.682, "end": 22.93}, {"w": "có", "start": 22.93, "end": 23.116}, {"w": "nửa", "start": 23.116, "end": 23.364}, {"w": "đêm", "start": 23.364, "end": 23.612}, {"w": "là", "start": 23.612, "end": 23.798}, {"w": "của", "start": 23.798, "end": 24.046}, {"w": "riêng", "start": 24.046, "end": 24.419}, {"w": "con.", "start": 24.419, "end": 24.729}]}, {"speaker": "meo", "scene": "title", "text": "Bẩm, người trần gọi đây là trì hoãn giờ ngủ. Trên mạng còn gọi là thức khuya để trả thù.", "start": 25.079, "end": 30.727, "words": [{"w": "Bẩm,", "start": 25.079, "end": 25.376}, {"w": "người", "start": 25.376, "end": 25.733}, {"w": "trần", "start": 25.733, "end": 26.031}, {"w": "gọi", "start": 26.031, "end": 26.269}, {"w": "đây", "start": 26.269, "end": 26.507}, {"w": "là", "start": 26.507, "end": 26.686}, {"w": "trì", "start": 26.686, "end": 26.924}, {"w": "hoãn", "start": 26.924, "end": 27.222}, {"w": "giờ", "start": 27.222, "end": 27.46}, {"w": "ngủ.", "start": 27.46, "end": 27.757}, {"w": "Trên", "start": 27.757, "end": 28.055}, {"w": "mạng", "start": 28.055, "end": 28.353}, {"w": "còn", "start": 28.353, "end": 28.591}, {"w": "gọi", "start": 28.591, "end": 28.829}, {"w": "là", "start": 28.829, "end": 29.007}, {"w": "thức", "start": 29.007, "end": 29.305}, {"w": "khuya", "start": 29.305, "end": 29.662}, {"w": "để", "start": 29.662, "end": 29.841}, {"w": "trả", "start": 29.841, "end": 30.079}, {"w": "thù.", "start": 30.079, "end": 30.377}]}, {"speaker": "dv", "scene": "court", "dv": "smug", "hon": "scared", "text": "Trả thù? Ngươi trả thù ai?", "start": 30.727, "end": 33.738, "words": [{"w": "Trả", "start": 30.727, "end": 31.121}, {"w": "thù?", "start": 31.121, "end": 31.614}, {"w": "Ngươi", "start": 31.614, "end": 32.205}, {"w": "trả", "start": 32.205, "end": 32.599}, {"w": "thù", "start": 32.599, "end": 32.994}, {"w": "ai?", "start": 32.994, "end": 33.388}]}, {"speaker": "meo", "scene": "battery", "text": "Trả thù cái ngày bị lấy mất. Nhưng càng mệt thì sức tự kiểm soát càng cạn, nên càng khó đặt điện thoại xuống.", "start": 33.738, "end": 40.39, "words": [{"w": "Trả", "start": 33.738, "end": 33.967}, {"w": "thù", "start": 33.967, "end": 34.196}, {"w": "cái", "start": 34.196, "end": 34.425}, {"w": "ngày", "start": 34.425, "end": 34.712}, {"w": "bị", "start": 34.712, "end": 34.884}, {"w": "lấy", "start": 34.884, "end": 35.113}, {"w": "mất.", "start": 35.113, "end": 35.399}, {"w": "Nhưng", "start": 35.399, "end": 35.743}, {"w": "càng", "start": 35.743, "end": 36.029}, {"w": "mệt", "start": 36.029, "end": 36.259}, {"w": "thì", "start": 36.259, "end": 36.488}, {"w": "sức", "start": 36.488, "end": 36.717}, {"w": "tự", "start": 36.717, "end": 36.889}, {"w": "kiểm", "start": 36.889, "end": 37.175}, {"w": "soát", "start": 37.175, "end": 37.462}, {"w": "càng", "start": 37.462, "end": 37.748}, {"w": "cạn,", "start": 37.748, "end": 38.035}, {"w": "nên", "start": 38.035, "end": 38.264}, {"w": "càng", "start": 38.264, "end": 38.55}, {"w": "khó", "start": 38.55, "end": 38.779}, {"w": "đặt", "start": 38.779, "end": 39.008}, {"w": "điện", "start": 39.008, "end": 39.295}, {"w": "thoại", "start": 39.295, "end": 39.639}, {"w": "xuống.", "start": 39.639, "end": 40.04}]}, {"speaker": "meo", "scene": "loop", "text": "T